OPENAI_API_KEY=
PORT=8000
# Viator Partner API (Basic Access). VIATOR_ENV is sandbox or production.
VIATOR_API_KEY=
VIATOR_ENV=production
GEOAPIFY_API_KEY=
TAVILY_API_KEY=
# demo (default): sample data, no AI, no key. agents: Claude Managed Agents (needs the settings below and
# agents/agents.lock.json, written once by: .venv/bin/python -m scripts.create_agents).
MODE=demo

# --- Claude Managed Agents (MODE=agents) ---
# Your Anthropic API key, read by the anthropic SDK. Never commit it or paste it anywhere else.
ANTHROPIC_API_KEY=
# The model for both agents (scripts/create_agents.py) and for every session (backend/agents.py).
AGENT_MODEL=claude-opus-5-5
# Hard cost cap per session in whole US cents, at list price (tokens + web searches + running time): 100 = $1.00.
# The platform pauses a session at its cap; the trip then fails with the cost recorded. Quick search and swap use
# the researcher's cap.
RESEARCHER_CAP_CENTS=100
VERIFIER_CAP_CENTS=50
# Time limit per session, in seconds: after it the code interrupts the session and the step fails.
AGENT_DEADLINE_S=600
