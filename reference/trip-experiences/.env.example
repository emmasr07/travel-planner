# Copy to .env (never committed). MODE=demo runs without any key and without calling a model.
MODE=demo
PORT=8000
# For MODE=agents: an Anthropic API key (console.anthropic.com), then run once: python -m agents.create_agents
ANTHROPIC_API_KEY=
# Hard cap per session in US cents, enforced by the platform
RESEARCHER_CAP_CENTS=400
VERIFIER_CAP_CENTS=300
